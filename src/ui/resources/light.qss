/* =============================================================================
   PwdVault - Light Theme QSS (明亮清晰 · GitHub 风格)
   强调色：信任蓝 #2f5fff

   设计原则（参考 GitHub Light）：
     1. 双层背景层次 —— sidebar 用 #EDF1F7（略深），topbar / 内容区用
        #f5f8fc，靠色差区分主次区域，分界线用低饱和浅色实线。
     2. 柔和边框 —— 用低透明度 rgba 而非硬实色，视觉更轻盈。
     3. 细分隔线 —— 分隔线比边框更浅，避免视觉切割。
     4. 更多留白 —— 增大 padding/margin，呼吸感更好。
     5. 卡片作为唯一"层级"标识 —— 卡片背景 #ffffff，与主背景区分。
   ============================================================================= */

/* ── 颜色变量（QSS 不支持变量，此处仅作注释参考） ──
   主背景 base     = #f5f8fc
   侧栏底色 sidebar= #EDF1F7
   左右分界 vline  = #D5DCE8
   上下分界 hline  = #D5DCE8
   卡片背景 card   = #ffffff
   悬浮背景 hover  = rgba(15, 22, 38, 0.04)
   柔和边框 border = rgba(15, 22, 38, 0.08)
   细分隔线 divide = rgba(15, 22, 38, 0.06)
   主色 primary    = #2f5fff
   正文 fg         = #0f1626
   次要 fg muted   = #5c6678
   ============================================================================= */

/* ── 全局基础 ── */
/* font-family 不在此声明：Qt 的 QSS 对缺失字符的回退不可靠，会走系统默认
   fallback（Windows 上常为 SimSun 点阵字，导致中文发虚）。改由 main.cpp 中
   QApplication::setFont + QFont::setFamilies 设置字符级回退链
   （Segoe UI → Microsoft YaHei UI），此处只保留字号。 */
* {
    font-size: 13px;
    outline: none;
}

QWidget {
    background-color: #f5f8fc;
    color: #0f1626;
}

QToolTip {
    background-color: #ffffff;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.08);
    border-radius: 6px;
    padding: 2px 4px;
    font-size: 12px;
}

/* ── 滚动条：纤细低调 ── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: rgba(15, 22, 38, 0.14);
    border-radius: 4px;
    min-height: 32px;
    min-width: 32px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgba(15, 22, 38, 0.22);
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── card 内细线滚动条（cardScroll）──
   2px 宽细线，上下 margin 14px 避让 card 圆角（border-radius:12px）+ 2px 余量，
   track 透明，handle 无边框圆角，紧贴 card 右边框内侧不超出圆角。
   cardScroll 列表自身 padding:0，确保滚动条紧贴 card 右边框。 */
[cssClass="cardScroll"] {
    padding: 0;
}
[cssClass="cardScroll"] QScrollBar:vertical {
    background: transparent;
    width: 2px;
    margin: 14px 0 14px 0;
    border: none;
}
[cssClass="cardScroll"] QScrollBar::handle:vertical {
    background: rgba(15, 22, 38, 0.14);
    border: none;
    border-radius: 1px;
    min-height: 32px;
    margin: 0;
}
[cssClass="cardScroll"] QScrollBar::handle:vertical:hover {
    background: rgba(15, 22, 38, 0.22);
}
[cssClass="cardScroll"] QScrollBar::add-line,
[cssClass="cardScroll"] QScrollBar::sub-line {
    height: 0;
    width: 0;
}
[cssClass="cardScroll"] QScrollBar::add-page,
[cssClass="cardScroll"] QScrollBar::sub-page {
    background: transparent;
}

/* ── 通用按钮 ── */
QPushButton {
    background-color: transparent;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.10);
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: rgba(15, 22, 38, 0.04);
    border-color: rgba(15, 22, 38, 0.16);
}
QPushButton:pressed {
    background-color: rgba(15, 22, 38, 0.08);
}
QPushButton:disabled {
    color: #a3afc4;
    border-color: rgba(15, 22, 38, 0.06);
}

/* 主按钮（primary）：浅色主题用黑色背景 + 白色文字，对比强烈 */
QPushButton#primaryButton,
QPushButton[cssClass="primary"] {
    background-color: #0f1626;
    color: #ffffff;
    border: none;
    font-weight: 500;
    padding: 0 18px;
}
QPushButton#primaryButton:hover,
QPushButton[cssClass="primary"]:hover {
    background-color: #2a3344;
}
QPushButton#primaryButton:pressed,
QPushButton[cssClass="primary"]:pressed {
    background-color: #000000;
}
QPushButton#primaryButton:disabled,
QPushButton[cssClass="primary"]:disabled {
    background-color: #d6e0ff;
    color: #6f7d99;
}

/* 危险按钮 */
QPushButton[cssClass="danger"] {
    color: #dc2626;
    border: 1px solid rgba(220, 38, 38, 0.32);
}
QPushButton[cssClass="danger"]:hover {
    background-color: rgba(220, 38, 38, 0.08);
    border-color: rgba(220, 38, 38, 0.40);
}

/* 图标按钮（仅图标，无文字） */
QPushButton[cssClass="icon"] {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    min-width: 36px;
    min-height: 36px;
    qproperty-iconSize: 18px 18px;
}
QPushButton[cssClass="icon"]:hover {
    background-color: rgba(15, 22, 38, 0.05);
}
QPushButton[cssClass="icon"]:pressed {
    background-color: rgba(15, 22, 38, 0.10);
}

/* 小图标按钮（28px） */
QPushButton[cssClass="iconSm"] {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    min-width: 28px;
    min-height: 28px;
    qproperty-iconSize: 16px 16px;
}
QPushButton[cssClass="iconSm"]:hover {
    background-color: rgba(15, 22, 38, 0.05);
}

/* ── 侧边栏导航按钮 ── */
QPushButton[cssClass="navItem"] {
    background-color: transparent;
    color: #5c6678;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0 14px;
    min-height: 40px;
}
QPushButton[cssClass="navItem"]:hover {
    background-color: rgba(15, 22, 38, 0.04);
    color: #0f1626;
}
QPushButton[cssClass="navItem"]:checked {
    background-color: rgba(47, 95, 255, 0.10);
    color: #0f1626;
}

/* ── 输入框 ── */
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.10);
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: rgba(47, 95, 255, 0.25);
    selection-color: #0f1626;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, QComboBox:hover {
    border-color: rgba(15, 22, 38, 0.18);
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: #2f5fff;
}

/* ── 焦点视觉（键盘导航可见性） ──
   * { outline: none; } 已屏蔽默认焦点虚线，下面按控件类型补回焦点视觉：
   - 有边框的控件（QPushButton/QSpinBox/QDoubleSpinBox）：变更 border-color
   - 无边框的 QCheckBox/QRadioButton：用 outline 重新绘制
   - 列表/表格/树：1px 实色边框
   以下 :focus 选择器特异性高于 * { outline: none; }，故 outline 属性会生效。 */
QPushButton:focus {
    border-color: #2f5fff;
}
QPushButton[cssClass="primary"]:focus {
    outline: 2px solid #2f5fff;
    outline-offset: 1px;
}
QCheckBox:focus, QRadioButton:focus {
    outline: 1px solid #2f5fff;
    outline-offset: 2px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2f5fff;
}
QListWidget:focus, QTableWidget:focus, QTreeView:focus {
    border: 1px solid #2f5fff;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    color: #a3afc4;
    background-color: rgba(15, 22, 38, 0.02);
}
QLineEdit[cssClass="withIcon"] {
    padding-left: 36px;
}
QLineEdit[cssClass="withIconRight"] {
    padding-right: 36px;
}
QLineEdit[cssClass="withIconBoth"] {
    padding-left: 36px;
    padding-right: 76px;
}
QLineEdit::placeholder, QPlainTextEdit::placeholder {
    color: #98a2b3;
}

/* QComboBox 下拉箭头 */
QComboBox::drop-down {
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 16px;
    height: 16px;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.10);
    border-radius: 6px;
    padding: 4px;
    selection-background-color: rgba(47, 95, 255, 0.18);
    selection-color: #0f1626;
    outline: none;
}

/* QSpinBox 上下箭头 */
QSpinBox::up-button, QSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

/* ── 文本标签 ── */
QLabel {
    background: transparent;
    color: #0f1626;
}
QLabel[cssClass="muted"] {
    color: #5c6678;
}
QLabel[cssClass="title"] {
    font-size: 16px;
    font-weight: 600;
}
QLabel[cssClass="titleLg"] {
    font-size: 20px;
    font-weight: 600;
}
QLabel[cssClass="caption"] {
    color: #5c6678;
    font-size: 11px;
}
QLabel[cssClass="sectionTitle"] {
    font-size: 15px;
    font-weight: 600;
}
QLabel[cssClass="fieldLabel"] {
    color: #0f1626;
    font-size: 13px;
    font-weight: 500;
}
QLabel[cssClass="fieldCaption"] {
    color: #5c6678;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QLabel[cssClass="error"] {
    color: #dc2626;
}
QLabel[cssClass="success"] {
    color: #1f9d57;
}
QLabel[cssClass="warning"] {
    color: #c9820a;
}
QLabel[cssClass="info"] {
    color: #2f5fff;
}
QLabel[cssClass="veryStrong"] {
    color: #0f7a3d;
    font-weight: 600;
}

/* 状态徽章 */
QLabel[cssClass="badge"] {
    background-color: rgba(15, 22, 38, 0.05);
    color: #5c6678;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}
QLabel[cssClass="badgeSuccess"] {
    background-color: rgba(31, 157, 87, 0.12);
    color: #1f9d57;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}
QLabel[cssClass="badgeWarning"] {
    background-color: rgba(201, 130, 10, 0.12);
    color: #c9820a;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}
QLabel[cssClass="badgeDanger"] {
    background-color: rgba(220, 38, 38, 0.12);
    color: #dc2626;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}
QLabel[cssClass="badgeInfo"] {
    background-color: rgba(47, 95, 255, 0.12);
    color: #2f5fff;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}
QLabel[cssClass="badgeVeryStrong"] {
    background-color: rgba(15, 122, 61, 0.16);
    color: #0f7a3d;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* 头像（首字母圆形） */
QLabel[cssClass="avatar"] {
    background-color: rgba(47, 95, 255, 0.10);
    color: #2f5fff;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    padding: 0;
    margin: 0;
}
QLabel[cssClass="avatarLg"] {
    background-color: rgba(47, 95, 255, 0.10);
    color: #2f5fff;
    border-radius: 28px;
    font-size: 20px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
    min-width: 56px;
    min-height: 56px;
    max-width: 56px;
    max-height: 56px;
    padding: 0;
    margin: 0;
}

/* ── 卡片容器（唯一"层级"标识，与主背景区分） ── */
QFrame[cssClass="card"] {
    background-color: #ffffff;
    border: 1px solid #D5DCE8;
    border-radius: 12px;
}
QFrame[cssClass="cardDanger"] {
    background-color: #ffffff;
    border: 1px solid #F85149;
    border-radius: 12px;
}
/* 危险操作 card 内所有非按钮文本统一亮红（QPushButton 非 QLabel，不受影响） */
QFrame[cssClass="cardDanger"] QLabel {
    color: #F85149;
}
/* 危险操作 card 内字段行分隔线统一亮红，覆盖 fieldRow 默认淡灰色 */
QFrame[cssClass="cardDanger"] QFrame[cssClass="fieldRow"] {
    border-bottom: 1px solid #F85149;
}
/* card 内的普通 QWidget 子容器必须透明，否则继承全局 QWidget 底色覆盖 card 底色 */
QFrame[cssClass="card"] > QWidget,
QFrame[cssClass="cardDanger"] > QWidget {
    background: transparent;
}
QFrame[cssClass="fieldRow"] > QWidget {
    background: transparent;
}

/* 侧边栏：底色 #EDF1F7 略深于内容区，靠色差区分主次 */
QFrame[cssClass="sidebar"] {
    background-color: #EDF1F7;
    border-right: 1px solid #D5DCE8;
}
/* sidebar 内子 frame（品牌区/导航/底部状态）设为透明，
   让 sidebar 的背景色 #EDF1F7 和 border-right 分界线透出，
   避免子 frame 不透明背景覆盖 border-right 导致看不到分界线 */
QFrame#sidebarFrame > QFrame {
    background: transparent;
}
/* 顶栏：与主背景同色，底部 #D5DCE8 实线分界 */
QFrame[cssClass="topbar"] {
    background-color: #f5f8fc;
    border-bottom: 1px solid #D5DCE8;
}

/* 模态弹窗 */
/* border-radius 8px 与 Win11 DWM 主窗口圆角视觉对齐；
   圆角外区域由 WA_TranslucentBackground 透出主窗口圆角，避免遮罩覆盖桌面。 */
QFrame[cssClass="modalOverlay"] {
    background-color: rgba(15, 22, 38, 0.45);
    border-radius: 8px;
}
QFrame[cssClass="modal"] {
    background-color: #ffffff;
    border: 1px solid rgba(15, 22, 38, 0.08);
    border-radius: 12px;
}
QFrame[cssClass="modalHeader"] {
    background-color: transparent;
    border-bottom: 1px solid rgba(15, 22, 38, 0.06);
}
QFrame[cssClass="modalBody"] {
    background-color: transparent;
    border: none;
}
QFrame[cssClass="modalFooter"] {
    background-color: transparent;
    border-top: 1px solid rgba(15, 22, 38, 0.06);
}
QFrame[cssClass="divider"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(15, 22, 38, 0.06);
}
QFrame[cssClass="infoBox"] {
    background-color: rgba(47, 95, 255, 0.08);
    border: 1px solid rgba(47, 95, 255, 0.16);
    border-radius: 8px;
}

/* ── 滚动区域（透明背景，让父容器底色透出） ── */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* ── 列表（QListWidget 用于密码本左侧列表，QListView 用于 delegate 自绘列表） ── */
QListWidget, QListView {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    outline: none;
    padding: 4px;
}
QListWidget::item {
    background-color: transparent;
    color: #0f1626;
    border-radius: 8px;
    padding: 10px 12px;
    margin: 2px 0;
}
QListWidget::item:hover {
    background-color: rgba(15, 22, 38, 0.04);
}
QListWidget::item:selected {
    background-color: rgba(47, 95, 255, 0.10);
    color: #0f1626;
}

/* ── QTableWidget ── */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: rgba(15, 22, 38, 0.06);
    selection-background-color: rgba(47, 95, 255, 0.10);
    selection-color: #0f1626;
    outline: none;
}
QHeaderView::section {
    background-color: transparent;
    color: #5c6678;
    border: none;
    border-bottom: 1px solid rgba(15, 22, 38, 0.06);
    padding: 10px 14px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── QProgressBar（强度条） ── */
QProgressBar {
    background-color: rgba(15, 22, 38, 0.06);
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 3px;
}

/* ── QCheckBox / QRadioButton ── */
QCheckBox, QRadioButton {
    background: transparent;
    color: #0f1626;
    spacing: 8px;
    padding: 2px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(15, 22, 38, 0.18);
    border-radius: 3px;
    background-color: #ffffff;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #2f5fff;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2f5fff;
    border-color: #2f5fff;
    image: url(:/icons/check.svg);
}

/* ── 分段控件容器 ── */
QFrame[cssClass="segmented"] {
    background-color: rgba(15, 22, 38, 0.04);
    border-radius: 6px;
    padding: 4px;
}
QPushButton[cssClass="segmentedItem"] {
    background-color: transparent;
    color: #5c6678;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 24px;
}
QPushButton[cssClass="segmentedItem"]:hover {
    color: #0f1626;
}
QPushButton[cssClass="segmentedItem"]:checked {
    background-color: #2f5fff;
    color: #ffffff;
    font-weight: 500;
}

/* ── 菜单（QMenu） ── */
QMenu {
    background-color: #ffffff;
    border: 1px solid rgba(15, 22, 38, 0.10);
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: rgba(47, 95, 255, 0.18);
}
QMenu::separator {
    height: 1px;
    background-color: rgba(15, 22, 38, 0.06);
    margin: 4px 8px;
}

/* ── QDialog ── */
QDialog {
    background-color: #f5f8fc;
}

/* ── QPlainTextEdit（备注） ── */
QPlainTextEdit {
    line-height: 150%;
}

/* ── 警告/提示行 ── */
QFrame[cssClass="warningBox"] {
    background-color: rgba(201, 130, 10, 0.08);
    border: 1px solid rgba(201, 130, 10, 0.18);
    border-radius: 8px;
}
QFrame[cssClass="errorBox"] {
    background-color: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.18);
    border-radius: 8px;
}

/* 状态指示点 */
QLabel[cssClass="statusDotOk"] {
    background-color: #1f9d57;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
}
QLabel[cssClass="statusDotErr"] {
    background-color: #dc2626;
    border-radius: 4px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
}

/* 侧边栏当前选中项左侧高亮条 */
QLabel[cssClass="navIndicator"] {
    background-color: #2f5fff;
    border-radius: 2px;
    min-width: 3px;
    max-width: 3px;
}

/* 品牌标志色 */
QLabel[cssClass="brand"] {
    color: #2f5fff;
    font-size: 15px;
    font-weight: 600;
}

/* 强度条状态颜色（通过 dynamic property 控制）
   5 级：veryweak/weak/medium/strong/verystrong */
QProgressBar[strength="veryweak"]::chunk   { background-color: #b91c1c; }
QProgressBar[strength="weak"]::chunk       { background-color: #dc2626; }
QProgressBar[strength="medium"]::chunk     { background-color: #c9820a; }
QProgressBar[strength="strong"]::chunk     { background-color: #1f9d57; }
QProgressBar[strength="verystrong"]::chunk { background-color: #0f7a3d; }

/* =============================================================================
   扩展样式类（GitHub 风格 UI 重构）
   ============================================================================= */

/* 输入框容器：左侧图标 + 透明 QLineEdit + 可选右侧按钮（一体化边框） */
QFrame[cssClass="inputField"] {
    background-color: #EDF1F7;
    border: 1px solid rgba(15, 22, 38, 0.10);
    border-radius: 6px;
}
QFrame[cssClass="inputField"]:focus-within {
    border-color: #2f5fff;
}

/* 输入框容器内的透明 QLineEdit（融入容器） */
QLineEdit[cssClass="inlineEdit"] {
    background: transparent;
    color: #0f1626;
    border: none;
    padding: 0;
    font-size: 13px;
}
QLineEdit[cssClass="inlineEdit"]::placeholder {
    color: #98a2b3;
}

/* 输入框内的图标 label（lock / key / search / globe 等） */
QLabel[cssClass="inlineIcon"] {
    background: transparent;
    border: none;
}

/* 输入框内的小图标按钮（可见性切换 / 生成等，无文字） */
QPushButton[cssClass="inlineBtn"] {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5c6678;
}
QPushButton[cssClass="inlineBtn"]:hover {
    background: rgba(15, 22, 38, 0.06);
    color: #0f1626;
}

/* 输入框内的小文字按钮（如「生成」） */
QPushButton[cssClass="inlineTextBtn"] {
    background: transparent;
    color: #5c6678;
    border: none;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 12px;
}
QPushButton[cssClass="inlineTextBtn"]:hover {
    background: rgba(15, 22, 38, 0.06);
    color: #0f1626;
}

/* 轮廓按钮（透明 + 柔和边框 + hover 浅色） */
QPushButton[cssClass="outline"] {
    background: transparent;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.12);
    border-radius: 6px;
    padding: 0 14px;
    font-size: 13px;
}
QPushButton[cssClass="outline"]:hover {
    background: rgba(15, 22, 38, 0.04);
    border-color: rgba(15, 22, 38, 0.18);
}
QPushButton[cssClass="outline"]:pressed {
    background: rgba(15, 22, 38, 0.08);
}

/* 关闭按钮（hover 红色，模仿 Windows 原生体验） */
QPushButton[cssClass="closeBtn"] {
    background: transparent;
    border: none;
    border-radius: 6px;
}
QPushButton[cssClass="closeBtn"]:hover {
    background: #f56363;
}
QPushButton[cssClass="closeBtn"]:pressed {
    background: #d94f4f;
}

/* 等宽字体（密码、存储路径等） */
QLabel[cssClass="textMono"] {
    font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
}
QLineEdit[cssClass="textMono"] {
    font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
}

/* 存储路径显示框（mono 字体 + 浅色背景） */
QLabel[cssClass="pathBox"] {
    background-color: rgba(15, 22, 38, 0.03);
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.08);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
}

/* 设置页专属高度：用 #settingsView 作用域选择器，强制设置页内的
   outline/danger 按钮高度，不影响其他页面。
   inputField 底色已全局统一为 #EDF1F7，无需设置页专属覆盖。 */
QWidget#settingsView QPushButton[cssClass="outline"],
QWidget#settingsView QPushButton[cssClass="danger"] {
    min-height: 40px;
    max-height: 40px;
}
QWidget#settingsView QPushButton[cssClass="segmentedItem"] {
    min-height: 32px;
    max-height: 32px;
    padding: 0 14px;
}

/* 设置页 outline 按钮 + 下拉框底色统一为 #EDF1F7（与 inputField 一致）。
   hover/pressed 用预计算纯色模拟原 "alpha 叠加" 视觉效果：
   Qt QSS 的 rgba 会替换底色而非叠加，故改用预计算纯色保住底色。
   hover ≈ #EDF1F7 + 4% 黑，pressed ≈ #EDF1F7 + 8% 黑。 */
QWidget#settingsView QPushButton[cssClass="outline"],
QWidget#settingsView QComboBox {
    background-color: #EDF1F7;
}
QWidget#settingsView QPushButton[cssClass="outline"]:hover,
QWidget#settingsView QComboBox:hover {
    background-color: #E4E8EF;
}
QWidget#settingsView QPushButton[cssClass="outline"]:pressed,
QWidget#settingsView QComboBox:pressed {
    background-color: #DBDFE6;
}

/* 4 段强度条容器（ProgramPasswordDialog 用） */
QFrame[cssClass="strengthBar"] {
    background: transparent;
    border: none;
}

/* 强度条分段（QLabel，通过 strength 属性切换颜色） */
QLabel[cssClass="strengthSeg"] {
    background-color: rgba(15, 22, 38, 0.08);
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}
QLabel[cssClass="strengthSeg"][strength="veryweak"] {
    background-color: #b91c1c;
}
QLabel[cssClass="strengthSeg"][strength="weak"] {
    background-color: #dc2626;
}
QLabel[cssClass="strengthSeg"][strength="medium"] {
    background-color: #c9820a;
}
QLabel[cssClass="strengthSeg"][strength="strong"] {
    background-color: #1f9d57;
}
QLabel[cssClass="strengthSeg"][strength="verystrong"] {
    background-color: #0f7a3d;
}

/* 字段行（详情区每个字段一行的容器，带细分隔线） */
QFrame[cssClass="fieldRow"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(15, 22, 38, 0.06);
}

/* 空状态提示（密码本未选中条目时） */
QLabel[cssClass="emptyHint"] {
    color: #8b95a8;
    font-size: 14px;
    padding: 80px 0;
}

/* 录入/生成器 card 内的输入控件底色（统一为 #EDF1F7）
   用 #formCard 作用域提升优先级，覆盖 "QFrame[cssClass="card"] > QWidget"
   的透明规则，让 inputField 容器与原生输入控件都显示 #EDF1F7。 */
QFrame#formCard QFrame[cssClass="inputField"],
QFrame#formCard QLineEdit,
QFrame#formCard QSpinBox,
QFrame#formCard QPlainTextEdit {
    background-color: #EDF1F7;
}

/* =============================================================================
   标签芯片（tag chip）样式
   ============================================================================= */
QFrame[cssClass="tagChip"] {
    background-color: rgba(59, 107, 255, 0.10);
    border: 1px solid rgba(59, 107, 255, 0.22);
    border-radius: 12px;
    padding: 0;
    min-height: 22px;
    max-height: 22px;
}
QFrame[cssClass="tagChip"]:hover {
    background-color: rgba(59, 107, 255, 0.16);
    border-color: rgba(59, 107, 255, 0.30);
}
QLabel[cssClass="tagChipName"] {
    background: transparent;
    color: #2a55c8;
    font-size: 12px;
    padding: 0 2px;
}
/* 芯片删除按钮（×） */
QToolButton#tagChipRemove {
    background: transparent;
    border: none;
    color: #2a55c8;
    font-size: 14px;
    padding: 0;
    margin: 0;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}
QToolButton#tagChipRemove:hover {
    color: #ffffff;
    background: rgba(15, 22, 38, 0.10);
    border-radius: 8px;
}

/* 标签输入容器（透明背景，让 chip 融入父容器） */
QWidget[cssClass="tagInput"] {
    background: transparent;
    border: none;
}

/* =============================================================================
   列表项小标签芯片（listTagChip）—— 比 detail 区的 tagChip 更紧凑
   ============================================================================= */
QLabel[cssClass="listTagChip"] {
    background-color: rgba(47, 95, 255, 0.10);
    color: #2a55c8;
    border: 1px solid rgba(47, 95, 255, 0.20);
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 10px;
    max-height: 18px;
}
QLabel[cssClass="listTagMore"] {
    background: transparent;
    color: #5c6678;
    font-size: 10px;
    padding: 1px 2px;
}

/* =============================================================================
   Markdown 渲染控件（QTextBrowser）
   ============================================================================= */
/* 特异性说明：加 QFrame[cssClass="fieldRow"] > 前缀，使特异性 (0,5,0) 高于
   QFrame[cssClass="fieldRow"] > QWidget 的 (0,4,0)，避免 markdownView 的
   #EDF1F7 背景被后者强制 transparent 覆盖。子规则（h1/code 等）不涉及背景
   且非 fieldRow 直接子 widget，无需加前缀。 */
QFrame[cssClass="fieldRow"] > QTextBrowser[cssClass="markdownView"] {
    /* 浅色主题自适配：#EDF1F7 与侧栏底色一致，与卡片背景 #ffffff 形成层次 */
    background-color: #EDF1F7;
    color: #0f1626;
    border: 1px solid rgba(15, 22, 38, 0.06);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
QTextBrowser[cssClass="markdownView"] h1 {
    color: #0f1626;
    font-size: 18px;
    font-weight: 600;
    margin: 12px 0 6px 0;
}
QTextBrowser[cssClass="markdownView"] h2 {
    color: #0f1626;
    font-size: 16px;
    font-weight: 600;
    margin: 10px 0 4px 0;
}
QTextBrowser[cssClass="markdownView"] h3 {
    color: #0f1626;
    font-size: 14px;
    font-weight: 600;
    margin: 8px 0 4px 0;
}
QTextBrowser[cssClass="markdownView"] code {
    background-color: rgba(15, 22, 38, 0.06);
    color: #c25400;
    padding: 1px 4px;
    border-radius: 3px;
    font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}
QTextBrowser[cssClass="markdownView"] pre {
    background-color: rgba(15, 22, 38, 0.04);
    border: 1px solid rgba(15, 22, 38, 0.06);
    border-radius: 6px;
    padding: 8px 12px;
    margin: 6px 0;
}
QTextBrowser[cssClass="markdownView"] pre code {
    background: transparent;
    color: #0f1626;
    padding: 0;
    border-radius: 0;
}
QTextBrowser[cssClass="markdownView"] a {
    color: #2a55c8;
    text-decoration: none;
}
QTextBrowser[cssClass="markdownView"] a:hover {
    text-decoration: underline;
}
QTextBrowser[cssClass="markdownView"] ul,
QTextBrowser[cssClass="markdownView"] ol {
    margin: 4px 0;
    padding-left: 20px;
}
QTextBrowser[cssClass="markdownView"] li {
    margin: 2px 0;
}
QTextBrowser[cssClass="markdownView"] p {
    margin: 4px 0;
}
QTextBrowser[cssClass="markdownView"] .muted {
    color: #5c6678;
}

/* =============================================================================
   透明背景容器（detail_container 等，需让 card 底色透出）
   ============================================================================= */
QWidget[cssClass="transparentBg"] {
    background-color: transparent;
}

/* 标签输入控件内的 QLineEdit（融入 TagInputWidget 容器） */
QLineEdit[cssClass="tagInput"] {
    border: none;
    background: transparent;
}
